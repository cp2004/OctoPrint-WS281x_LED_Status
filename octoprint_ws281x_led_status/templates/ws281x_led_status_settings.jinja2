{% import "macros/binding.jinja2" as binding %}

<h3>WS281x LED Status</h3>
<form class="form-horizontal">
    <!-- Hidden inputs to ensure backend/strip settings are saved when modal is used -->
    <input type="hidden" data-bind="value: {{ binding.bind_setting("backend.type") }}">
    <input type="hidden" data-bind="value: {{ binding.bind_setting("backend.config.count") }}">
    <input type="hidden" data-bind="value: {{ binding.bind_setting("backend.config.brightness") }}">
    <input type="hidden" data-bind="value: {{ binding.bind_setting("backend.config.pin") }}">
    <input type="hidden" data-bind="value: {{ binding.bind_setting("backend.config.freq_hz") }}">
    <input type="hidden" data-bind="value: {{ binding.bind_setting("backend.config.dma") }}">
    <input type="hidden" data-bind="checked: {{ binding.bind_setting("backend.config.invert") }}">
    <input type="hidden" data-bind="value: {{ binding.bind_setting("backend.config.channel") }}">
    <input type="hidden" data-bind="value: {{ binding.bind_setting("backend.config.type") }}">
    <input type="hidden" data-bind="value: {{ binding.bind_setting("backend.config.pixel_order") }}">
    <input type="hidden" data-bind="value: {{ binding.bind_setting("strip.adjustment.R") }}">
    <input type="hidden" data-bind="value: {{ binding.bind_setting("strip.adjustment.G") }}">
    <input type="hidden" data-bind="value: {{ binding.bind_setting("strip.adjustment.B") }}">
    <input type="hidden" data-bind="checked: {{ binding.bind_setting("strip.white_override") }}">
    <input type="hidden" data-bind="value: {{ binding.bind_setting("strip.white_brightness") }}">
    <input type="hidden" data-bind="checked: {{ binding.bind_setting("features.sacrifice_pixel") }}">

    <button class="btn  btn-primary" data-toggle="modal" data-target="#LEDStripEditor"><i class="fa fa-pencil-square-o" aria-hidden="true"></i> LED Strip settings</button>
    <br>
    <div class="tabbable" style="padding-top: 10px">
        <ul class="nav nav-pills">
            <li class="active"><a href="#tabOverview" data-toggle="tab">Overview</a></li>
            <li><a href="#tabPrinting" data-toggle="tab">Printing effects</a></li>
            <li><a href="#tabProgress" data-toggle="tab">Progress effects</a></li>
            <li><a href="#tabFeatures" data-toggle="tab">Features</a></li>
            <li><a href="#tabCustomize" data-toggle="tab">Customize</a></li>
            <li><a href="#tabUtilities" data-toggle="tab">Utilities</a></li>
            <li><a href="#tabAbout" data-toggle="tab">About</a></li>
        </ul>
        <div class="tab-content">
            <div class="tab-pane active" id="tabOverview">
                {% include "settings/overview.jinja2" %}
            </div>
            <div class="tab-pane" id="tabPrinting">
                {%  include "settings/printing_effects.jinja2" %}
            </div>
            <div class="tab-pane" id="tabProgress">
                {%  include "settings/progress_effects.jinja2" %}
            </div>
            <div class="tab-pane" id="tabFeatures">
                {%  include "settings/features.jinja2" %}
            </div>
            <div class="tab-pane" id="tabCustomize">
                {%  include "settings/customize.jinja2" %}
            </div>
            <div class="tab-pane" id="tabUtilities">
                {% include "settings/utilities.jinja2" %}
            </div>
            <div class="tab-pane" id="tabAbout">
                {%  include "settings/about.jinja2" %}
            </div>
        </div>
    </div>
</form>
{% include "settings/strip_modal.jinja2" %}
